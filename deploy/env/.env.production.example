# LIVE SERVER SETTINGS. Copy to /var/www/topup/.env on the server and fill in the empty values THERE.
# Never put real passwords or keys in this file, in git, or in chat. YOUR_DOMAIN = your real domain.

APP_NAME="Keo Topup"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://YOUR_DOMAIN
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Logs: one file per day, kept 30 days.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_LEVEL=info

BCRYPT_ROUNDS=12

# ---- Database (MariaDB on the same server) ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=topup
DB_USERNAME=topup
DB_PASSWORD=

# ---- Sessions, cache, queue ----
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
# A job may run up to --timeout (300 s). The queue must wait longer than that before it hands a job to another worker.
DB_QUEUE_RETRY_AFTER=420
FILESYSTEM_DISK=local

# ---- E-mail (password reset, notifications). Use a real mail service, see deploy/DEPLOY-GUIDE.md ----
MAIL_MAILER=smtp
MAIL_SCHEME=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@YOUR_DOMAIN
MAIL_FROM_NAME="${APP_NAME}"
NOTIFY_BY_MAIL=false

# ---- Deposits ----
DEPOSIT_MIN=1.00
DEPOSIT_MAX=500.00
DEPOSIT_EXPIRE_MINUTES=30

# ---- ABA PayWay payment worker ----
# The payment link is private: paste it only into the .env on the server.
PAYWAY_LINK_URL=
# Supervisor does not search PATH, so use the full path (check with: which node).
PAYWAY_NODE_BINARY=/usr/bin/node
PAYWAY_SESSION_SECONDS=200
PAYWAY_QR_SECONDS=175
PAYWAY_HEADLESS=true

# ---- FazerCards (game top-up supplier) ----
FAZERCARDS_API_URL=https://api.fzr.cards/api/v2
FAZERCARDS_API_KEY=
# MUST be false on the live site (true = orders are only pretended).
FAZERCARDS_FAKE=false
FAZERCARDS_LOW_BALANCE=20.00
FAZERCARDS_BALANCE_MAX_AGE=30
# Leave empty until the https site is live and you have set the webhook up at FazerCards (see Phase 8 notes).
FAZERCARDS_WEBHOOK_SECRET=

# ---- Google sign-in (optional; leave empty to hide the button) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR_DOMAIN/auth/google/callback
